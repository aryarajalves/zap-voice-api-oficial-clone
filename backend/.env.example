# ========================================
# ZapVoice - Backend Configuração (.env.example)
# ========================================
# Copie este arquivo para .env na pasta backend e preencha com as credenciais do seu projeto.
# Este arquivo é a fonte de verdade para o setup do projeto.

# === WhatsApp Oficial (Meta Cloud API) ===
# [OPCIONAL] Credenciais para comunicação com a API do WhatsApp Business da Meta
WA_BUSINESS_ACCOUNT_ID=seu_business_account_id_aqui
WA_PHONE_NUMBER_ID=seu_phone_number_id_aqui
WA_ACCESS_TOKEN=seu_token_de_acesso_permanente_aqui

# === Cadastro Incorporado da Meta (Embedded Signup) ===
# [OPCIONAL] App ID da Meta para inicializar o SDK de Login
META_APP_ID=seu_app_id_da_meta_aqui
# [OPCIONAL] Config ID para o fluxo de login do cadastro incorporado
META_CONFIG_ID=seu_config_id_da_meta_aqui

# === Chatwoot ===
# [OPCIONAL] Configurações para integração com Chatwoot
CHATWOOT_API_URL=https://seu-chatwoot.com/api/v1
CHATWOOT_API_TOKEN=seu_token_chatwoot
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_SELECTED_INBOX_ID=1

# === Baserow (CRM) ===
# [OPCIONAL] Integração legada com Baserow
BASEROW_API_URL=https://seu-baserow.com
BASEROW_TOKEN=seu_token_baserow
BASEROW_TABLE_ID=123

# === URLs da Aplicação ===
# [OBRIGATÓRIO] URLs de API, WebSocket e Webhook
VITE_API_URL=https://seu-dominio.com
VITE_WS_URL=wss://seu-dominio.com
WEBHOOK_BASE_URL=https://seu-dominio.com

# === PostgreSQL ===
# [OBRIGATÓRIO] URL de conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql://postgres:senha_segura@postgres:5432/zapvoice_production

# === Segurança ===
# [OBRIGATÓRIO] Chave secreta JWT (mínimo 32 caracteres) e Token de Verificação do Webhook da Meta
SECRET_KEY=troque_isso_por_uma_chave_aleatoria_segura_de_mais_de_32_caracteres
WHATSAPP_VERIFY_TOKEN=seu_webhook_token_2026
REGISTER_API_KEY=sua_chave_secreta_para_registrar_123

# === CORS ===
# [OPCIONAL] Origens permitidas para requisições cross-origin (separadas por vírgula)
CORS_ORIGINS=https://seu-dominio.com,https://seu-outro-dominio.com

# === RabbitMQ ===
# [OBRIGATÓRIO] Conexão com o RabbitMQ local para filas de mensagens e tarefas
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# [OPCIONAL] Número de eventos simultâneos consumidos da fila whatsapp_events (padrão: 100)
RABBITMQ_EVENTS_PREFETCH_COUNT=100

# === Fuso Horário e Porta ===
# [OBRIGATÓRIO] Fuso horário do sistema e porta de execução
TZ=America/Sao_Paulo
PORT=8000

# [OPCIONAL] Nome da empresa/servidor para diferenciar nos nomes de arquivos de backup.
COMPANY_NAME=nome_da_sua_empresa

# === Cloud Storage (S3 / MinIO) ===
# [OPCIONAL] Configurações para uploads de arquivos de mídia (MinIO local)
S3_ENDPOINT_URL=http://zapvoice-minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=zap-voice
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9005

# === Backblaze B2 (Exclusivo para Backups do Postgres) ===
# [OPCIONAL] Credenciais para salvar os backups automáticos no Backblaze B2
BACKBLAZE_S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
BACKBLAZE_S3_ACCESS_KEY=chave_de_acesso_backblaze
BACKBLAZE_S3_SECRET_KEY=chave_secreta_backblaze
BACKBLAZE_S3_BUCKET_NAME=zap-voice-backup
BACKBLAZE_S3_REGION=us-west-004

# [OPCIONAL] Prefixo (pasta) dentro do bucket onde os backups do banco serão armazenados.
# Padrão: backups/
S3_BACKUP_PREFIX=backups/


# === Limites de Taxa (Rate Limiting) ===
# [OPCIONAL] Define se o limitador de taxa (slowapi) deve estar ativo.
# Defina como "false" para executar testes de integração sem bloqueio por 429.
RATE_LIMIT_ENABLED=true



# === Retenção de Dados ===
# [OPCIONAL] Dias para manter histórico no banco e nos logs do container
HISTORY_RETENTION_DAYS=30
LOG_RETENTION_DAYS=7

# === Super Admin Inicial ===
# [OBRIGATÓRIO] Credenciais criadas automaticamente no boot do backend
SUPER_ADMIN_EMAIL=aryarajmarketing@gmail.com
SUPER_ADMIN_PASSWORD=123456

# === OpenAI (Integração IA) ===
# [OPCIONAL] Chave de API da OpenAI para análise de conversas por IA
OPENAI_API_KEY=sua_chave_openai_aqui
# [OPCIONAL] Modelo da OpenAI a ser utilizado por padrão (ex: gpt-5-mini)
OPENAI_API_MODEL=gpt-5-mini

# === Configurações de Simulação e Teste de Estresse ===
# [OPCIONAL] Se verdadeiro, simula o envio de mensagens para o Chatwoot e Meta sem disparar requisições HTTP reais.
# Por padrão é false ou vazio.
SIMULATE_MESSAGING=false

# [OPCIONAL] Se verdadeiro, simula retornos aleatórios de erro de Rate Limit (HTTP 429) do Chatwoot para testar resiliência.
SIMULATE_CHATWOOT_RATELIMIT=false


# === Instagram Automation ===
# [OPCIONAL] Token de verificação para o webhook do Instagram (Meta)
INSTAGRAM_VERIFY_TOKEN=seu_token_de_verificacao_instagram_aqui

# [OPCIONAL] Define se o acesso e processamento de automações/webhooks do Instagram está habilitado. Padrão: true
ENABLE_INSTAGRAM=true

# === Integração de Mensagens (AgentFlow / Webhook de Mensagens) ===
# [OPCIONAL] URL de Webhook para onde todas as novas mensagens do usuário e agente serão despachadas
CHAT_MESSAGES_WEBHOOK_URL=http://localhost:5678/webhook/messages

# === Resposta Automática (WhatsApp Apenas Comunicados) ===
# [OPCIONAL] Habilita/desabilita auto-reply de comunicados
WA_AUTO_REPLY_ENABLED=false
# [OPCIONAL] Mensagem padrão do auto-reply
WA_AUTO_REPLY_MESSAGE=Este número é só para comunicados.
