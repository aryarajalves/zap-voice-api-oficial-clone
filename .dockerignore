# ==============================================================================
# ZapVoice - Docker Ignore (.dockerignore)
# Impede que arquivos de backup, temporários, logs e testes entrem nas imagens
# ==============================================================================

# === Cópias Antigas e Backups (Clean Code) ===
*.backup.*
**/*.backup.*
*.backup
**/*.backup
*.bak
**/*.bak
*.old
**/*.old
*.orig
**/*.orig

# === Controle de Versão e IDEs ===
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.cursor

# === Caches e Binários Python ===
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# === Testes e Cobertura ===
tests/
tests_unit/
**/tests_unit/
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/

# === Logs e Depuração ===
*.log
**/*.log
logs/
zapvoice_debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Segredos e Configurações Locais (Usar env_file / Docker Secrets) ===
.env
.env.local
.env.development
.env.test
.env.production
!.env.example

# === Frontend / Node Dependencies e Caches ===
frontend/node_modules/
node_modules/
.npm/
.eslintcache
.stylelintcache

# === Imagens Temporárias e Artefatos de Teste ===
*.png
*.jpg
*.jpeg
*.mp4
*.ogg
*.opus
*.pdf
screenshot*.png
fixed_layout_*.png
modal_saved_*.png

# === Bancos Temporários / SQLite Locais ===
*.db
*.sqlite
*.sqlite3
test_*.db

# === Sistema Operacional ===
.DS_Store
Thumbs.db
desktop.ini
